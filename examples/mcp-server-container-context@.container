[Unit]
Description=A MCP server in container, providing isolated execution context
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=mcp-server-container-context-%i
Image=ghcr.io/lazzybit/mcp-server-container-context:latest

# Network=cloudflare-tunnel.network

[Service]
Restart=on-failure
TimeoutStopSec=30

[Install]
WantedBy=default.target
