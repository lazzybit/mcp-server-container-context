{
  "name": "mcp-server-container-context",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP Streamable HTTP server exposing read, write, edit and bash, fronted by Cloudflare Access.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/tools tests/auth",
    "test:mcp": "vitest run tests/mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "jose": "6.2.12",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
